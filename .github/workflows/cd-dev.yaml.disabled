name: CD - Deploy to Dev with Helm

on:
  workflow_run:
    workflows: ["CI - Build and Push Model API"]
    types:
      - completed

permissions:
  contents: read
  packages: read

jobs:
  deploy-dev:
    if: ${{ github.event.workflow_run.conclusion == 'success' }}
    runs-on: ubuntu-latest
    environment: dev

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install kubectl
        uses: azure/setup-kubectl@v4
        with:
          version: 'latest'

      - name: Install Helm
        uses: azure/setup-helm@v4
        with:
          version: 'latest'

      - name: Set kubeconfig
        run: |
          mkdir -p ~/.kube
          echo "${{ secrets.KUBE_CONFIG_DEV }}" > ~/.kube/config
          chmod 600 ~/.kube/config

      - name: Set image tag from triggering workflow SHA
        id: vars
        run: |
          FULL_SHA="${{ github.event.workflow_run.head_sha }}"
          SHORT_SHA="${FULL_SHA::7}"
          echo "short_sha=$SHORT_SHA" >> $GITHUB_OUTPUT

      - name: Helm upgrade/install to dev
        run: |
          helm upgrade --install aidp-dev ./charts/aidp \
            --namespace aidp-dev \
            --create-namespace \
            --set modelApi.image=ghcr.io/${{ github.repository_owner }}/aidp-model-api \
            --set modelApi.tag=${{ steps.vars.outputs.short_sha }} \
            --set modelApi.imagePullPolicy=IfNotPresent \
            --set ingress.host=aidp-dev.local

      - name: Check rollout
        run: |
          kubectl rollout status deployment/model-api -n aidp-dev --timeout=180s
          kubectl get pods -n aidp-dev